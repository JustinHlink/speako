# Copy to .env locally. Never commit your API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Set true only after checking that this API project has NO Cloud Billing enabled.
GEMINI_FREE_TIER_CONFIRMED=false
# Project-wide development + testing + instructor review ceiling, not per session.
PROJECT_BUDGET_USD=10
# Conservative paid-price equivalent used as a local usage guard, NOT an invoice.
RECORDED_EXTERNAL_SPEND_USD=0
MAX_API_ATTEMPTS=500

# Speech-to-text. groq runs Whisper on Groq's servers (fast, free tier).
# whisper runs it on this computer. gemini sends the recording to the Gemini API.
SPEECH_PROVIDER=groq
# The local model, used by SPEECH_PROVIDER=whisper and as the backup for groq.
# small.en is the most accurate in our tests. base.en is smaller and faster but less accurate.
WHISPER_MODEL=small.en
WHISPER_COMPUTE_TYPE=int8
# For SPEECH_PROVIDER=groq: your Groq API key, the Whisper model on Groq, and the backup.
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
# whisper: if Groq fails, use the local model. none: no backup.
SPEECH_FALLBACK=whisper

# Conversation replies. claude uses Claude Haiku; gemini uses the Gemini API instead.
REPLY_PROVIDER=claude
# Your Claude API key from the Claude Console. Never commit it.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
