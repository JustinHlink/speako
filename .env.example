# Copy to .env locally. Never commit your API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Set true only after checking that this API project has NO Cloud Billing enabled.
GEMINI_FREE_TIER_CONFIRMED=false
# Project-wide development + testing + instructor review ceiling, not per session.
PROJECT_BUDGET_USD=10
# Conservative paid-price equivalent used as a local usage guard, NOT an invoice.
RECORDED_EXTERNAL_SPEND_USD=0
MAX_API_ATTEMPTS=500

